{
  "name": "dsh-research-workbench",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "科研论文工作台：项目、资料与原生任务空间",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/server",
    "src/shared",
    "src/server-path.mjs",
    "public",
    "dist",
    "samples/figure",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup:dev": "node scripts/setup-dev.cjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yzyg6/dsh-research-workbench.git"
  }
}
